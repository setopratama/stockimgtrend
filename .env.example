# ==========================================
# Stock Image Trend Pipeline Configuration
# ==========================================

# Tavily Search API (Wajib)
# Dapatkan di https://app.tavily.com
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenRouter API (Wajib untuk AI Synthesis & Prompt Generator)
# Dapatkan di https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx

# Model OpenRouter yang digunakan
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Optional second-model evidence audit and demand forecast
# Recommended: deepseek/deepseek-chat
OPENROUTER_REASONING_MODEL=deepseek/deepseek-v4.1-flash-1017
OPENROUTER_REASONING_EFFORT=high

# Opsional direct API keys
GEMINI_API_KEY=
OPENAI_API_KEY=

# Pengaturan Pipeline
OUTPUT_DIR=docs/reports
LOG_LEVEL=INFO
